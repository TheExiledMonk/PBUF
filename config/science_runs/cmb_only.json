{
  "run_id": "cmb_only",
  "description": "Single-fit run for CMB distance priors only (LCDM + PBUF).",
  "joint_config": {
    "fits": [
      "cmb"
    ]
  },
  "parameter_bounds": {
    "lcdm": {
      "H0": [
        65,
        75
      ],
      "Omega_m0": [
        0.25,
        0.35
      ],
      "Omega_b0": [
        0.02,
        0.05
      ],
      "Omega_k0": [
        -0.03,
        0.03
      ]
    },
    "pbuf": {
      "H0": [
        60,
        80
      ],
      "Omega_m0": [
        0.326,
        0.326
      ],
      "Rmax": [
        90000000.0,
        90000000.0
      ]
    }
  },
  "models": [
    "pbuf"
  ],
  "scenarios": [
    {
      "id": "fit_cmb",
      "mode": "fit",
      "datasets": [
        "cmb"
      ],
      "notes": "CMB-only fit to reproduce distance priors."
    }
  ],
  "engine_settings": {
    "n_threads": 20,
