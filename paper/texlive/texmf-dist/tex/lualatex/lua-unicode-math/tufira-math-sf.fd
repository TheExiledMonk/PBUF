\ProvidesFile{tufira-math-sf.fd}
        [2025-12-11 v0.2 NFSS font definitions for Fira Math Script]
\DeclareFontFamily{TU}{fira-math-sf}{}
\DeclareFontShape{TU}{fira-math-sf}{m}{n}%
  {<-> \UnicodeFontFile{FiraMath-Regular}{mode=base;script=math;language=dflt;ssty=0;}}{}
\DeclareFontShape{TU}{fira-math-sf}{b}{n}%
  {<-> \UnicodeFontFile{FiraMath-Regular}{mode=base;script=math;language=dflt;embolden=3;ssty=0;}}{}

\endinput
