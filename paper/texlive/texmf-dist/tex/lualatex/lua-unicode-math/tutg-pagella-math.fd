\ProvidesFile{tutg-pagella-math.fd}
        [2025-12-11 v0.2 NFSS font definitions for TeX Gyre Pagella Math]
\DeclareFontFamily{TU}{tg-pagella-math}{}
\DeclareFontShape{TU}{tg-pagella-math}{m}{n}%
  {<-> \UnicodeFontFile{texgyrepagella-math}{mode=base;script=math;language=dflt;}}{}
\DeclareFontShape{TU}{tg-pagella-math}{b}{n}%
  {<-> \UnicodeFontFile{texgyrepagella-math}{mode=base;script=math;language=dflt;embolden=3;}}{}

\DeclareMathScriptfontMapping{TU}{tg-pagella-math}{TU}{tg-pagella-math-sf}{TU}{tg-pagella-math-ssf}
\endinput
