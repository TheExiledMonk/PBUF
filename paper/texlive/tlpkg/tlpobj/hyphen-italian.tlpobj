name hyphen-italian
category TLCore
revision 73410
catalogue ithyph
shortdesc Italian hyphenation patterns.
longdesc Hyphenation patterns for Italian in ASCII encoding. Compliant
longdesc with the Recommendation UNI 6461 on hyphenation issued by the
longdesc Italian Standards Institution (Ente Nazionale di Unificazione
longdesc UNI).
depend hyph-utf8
depend hyphen-base
execute AddHyphen 	name=italian 	lefthyphenmin=2 	righthyphenmin=2 	file=loadhyph-it.tex 	file_patterns=hyph-it.pat.txt 	file_exceptions=
containersize 3508
containerchecksum 88973a7a3d62a4a37b9875cf599a705965d34603ead5fab9003273f3fea4adaf6f10759a4aa75bd9614840ce4f618470b8f7f22725d349f5336bd5b8b497c271
runfiles size=5
 texmf-dist/tex/generic/hyph-utf8/loadhyph/loadhyph-it.tex
 texmf-dist/tex/generic/hyph-utf8/patterns/quote/hyph-quote-it.tex
 texmf-dist/tex/generic/hyph-utf8/patterns/tex/hyph-it.tex
 texmf-dist/tex/generic/hyph-utf8/patterns/txt/hyph-it.pat.txt
catalogue-ctan /language/hyphenation/ithyph.tex
catalogue-license lgpl
catalogue-topics hyphenation italian
catalogue-version 4.8g
